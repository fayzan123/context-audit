{
  "name": "context-audit",
  "version": "0.5.2",
  "description": "Audit every AI coding tool's instruction files in one run — Claude Code skills/agents/commands, Codex prompts and AGENTS.md, Cursor rules. What they cost every session, which never fire, and whether any are doing something they shouldn't. Deterministic, offline, zero dependencies.",
  "type": "module",
  "bin": {
    "context-audit": "dist/index.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/build-ui.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node test/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "cursor",
    "agents-md",
    "cursorrules",
    "agent-skills",
    "skills",
    "context-window",
    "token-usage",
    "audit",
    "lint",
    "security",
    "prompt-injection"
  ],
  "author": "Fayzan Malik",
  "license": "MIT",
  "repository": "github:fayzan123/context-audit",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0"
  }
}
